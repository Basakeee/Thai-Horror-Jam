    acceptAmbient: {r: 0.32, g: 0.3, b: 0.3, a: 1}
    acceptFogDensity: 0.004
    acceptVignette: 0.15
    acceptSaturation: 12
    acceptExposureAdd: 0.25
    acceptFadeSeconds: 3
  dialogue:
    intro: "\u0E2D\u0E32\u0E08\u0E32\u0E23\u0E22\u0E4C\u0E40\u0E1E\u0E35\u0E22\u0E23\u0E1C\u0E39\u0E01\u0E14\u0E49\u0E32\u0E22\u0E14\u0E33\u0E17\u0E35\u0E48\u0E02\u0E49\u0E2D\u0E21\u0E37\u0E2D\u0E20\u0E1E\n<size=32>\"\u0E1C\u0E39\u0E01\u0E44\u0E27\u0E49\u0E40\u0E2A\u0E23\u0E34\u0E21\u0E14\u0E27\u0E07...
      \u0E40\u0E1E\u0E23\u0E32\u0E30\u0E14\u0E27\u0E07\u0E21\u0E36\u0E07\u0E16\u0E36\u0E07\u0E06\u0E32\u0E15
      \u0E44\u0E21\u0E48\u0E1E\u0E49\u0E19\u0E2B\u0E01\u0E42\u0E21\u0E07\u0E40\u0E22\u0E47\u0E19\u0E27\u0E31\u0E19\u0E19\u0E35\u0E49\"</size>"
    auntMurmurs:
    - "\u0E2E\u0E37\u0E2D... \u0E15\u0E49\u0E19\u0E44\u0E21\u0E49\u0E02\u0E2D\u0E07\u0E25\u0E39\u0E01\u0E41\u0E21\u0E48\u0E43\u0E01\u0E25\u0E49\u0E15\u0E32\u0E22\u0E41\u0E25\u0E49\u0E27"
    - "\u0E41\u0E21\u0E48\u0E22\u0E49\u0E32\u0E22\u0E01\u0E23\u0E30\u0E16\u0E32\u0E07\u0E21\u0E32\u0E44\u0E27\u0E49\u0E23\u0E34\u0E21\u0E02\u0E2D\u0E1A
      \u0E43\u0E2B\u0E49\u0E42\u0E14\u0E19\u0E41\u0E14\u0E14\u0E19\u0E30\u0E25\u0E39\u0E01"
    - "\u0E40\u0E2D\u0E4B\u0E40\u0E2D\u0E4A\u0E22... \u0E40\u0E2D\u0E4B\u0E25\u0E39\u0E01\u0E41\u0E21\u0E48..."
    - "\u0E16\u0E49\u0E32\u0E40\u0E2D\u0E4B\u0E40\u0E23\u0E35\u0E22\u0E01\u0E41\u0E21\u0E48\u0E2A\u0E31\u0E01\u0E04\u0E33
      \u0E41\u0E21\u0E48\u0E08\u0E30\u0E27\u0E34\u0E48\u0E07\u0E25\u0E07\u0E44\u0E1B\u0E2B\u0E32\u0E40\u0E25\u0E22"
    phoneLines:
    - "\u0E2B\u0E21\u0E2D\u0E14\u0E39: \u0E2E\u0E31\u0E25\u0E42\u0E2B\u0E25... \u0E2D\u0E35\u0E01\u0E2A\u0E2D\u0E07\u0E19\u0E32\u0E17\u0E35\u0E01\u0E27\u0E48\u0E32\u0E01\u0E47\u0E04\u0E23\u0E1A\u0E41\u0E25\u0E49\u0E27"
    - "\u0E2B\u0E21\u0E2D\u0E14\u0E39: \u0E14\u0E27\u0E07\u0E40\u0E14\u0E47\u0E01\u0E04\u0E19\u0E19\u0E35\u0E49\u0E41\u0E23\u0E07\u0E14\u0E35
      \u0E15\u0E48\u0E2D\u0E2D\u0E32\u0E22\u0E38\u0E01\u0E39\u0E44\u0E14\u0E49\u0E2D\u0E35\u0E01\u0E22\u0E35\u0E48\u0E2A\u0E34\u0E1A\u0E1B\u0E35"
    - "\u0E2B\u0E21\u0E2D\u0E14\u0E39: \u0E2B\u0E38\u0E48\u0E19\u0E2D\u0E22\u0E39\u0E48\u0E43\u0E19\u0E01\u0E25\u0E48\u0E2D\u0E07\u0E43\u0E15\u0E49\u0E42\u0E15\u0E4A\u0E30
      \u0E23\u0E2B\u0E31\u0E2A\u0E01\u0E47\u0E27\u0E31\u0E19\u0E40\u0E14\u0E34\u0E21...
      \u0E27\u0E31\u0E19\u0E17\u0E35\u0E48\u0E01\u0E39\u0E44\u0E14\u0E49\u0E14\u0E27\u0E07\u0E41\u0E23\u0E01"
    auntStory:
    - "\u0E1B\u0E49\u0E32\u0E28\u0E23\u0E35: \u0E40\u0E2D\u0E4B\u0E01\u0E47\u0E44\u0E1B\u0E43\u0E2B\u0E49\u0E44\u0E2D\u0E49\u0E40\u0E1E\u0E35\u0E22\u0E23\u0E21\u0E31\u0E19\u0E14\u0E39\u0E14\u0E27\u0E07...
      \u0E41\u0E25\u0E49\u0E27\u0E01\u0E47\u0E15\u0E32\u0E22 \u0E52\u0E53 \u0E15\u0E38\u0E25\u0E32
      \u0E1B\u0E35\u0E17\u0E35\u0E48\u0E41\u0E25\u0E49\u0E27 \u0E2B\u0E01\u0E42\u0E21\u0E07\u0E40\u0E22\u0E47\u0E19\u0E40\u0E1B\u0E4A\u0E30"
    - "\u0E1B\u0E49\u0E32\u0E28\u0E23\u0E35: \u0E1E\u0E23\u0E30\u0E17\u0E35\u0E48\u0E27\u0E31\u0E14\u0E1A\u0E2D\u0E01\u0E1B\u0E49\u0E32\u0E27\u0E48\u0E32
      \u0E02\u0E2D\u0E07\u0E1E\u0E27\u0E01\u0E19\u0E35\u0E49\u0E41\u0E1E\u0E49\u0E44\u0E1F\u0E28\u0E32\u0E25\u0E1E\u0E23\u0E30\u0E20\u0E39\u0E21\u0E34
      \u0E15\u0E49\u0E2D\u0E07\u0E40\u0E1C\u0E32\u0E15\u0E48\u0E2D\u0E2B\u0E19\u0E49\u0E32\u0E21\u0E31\u0E19"
    - "\u0E1B\u0E49\u0E32\u0E28\u0E23\u0E35: ...\u0E41\u0E15\u0E48\u0E1A\u0E32\u0E07\u0E17\u0E35\u0E04\u0E19\u0E40\u0E23\u0E32\u0E01\u0E47\u0E2B\u0E19\u0E35\u0E14\u0E27\u0E07\u0E15\u0E31\u0E27\u0E40\u0E2D\u0E07\u0E44\u0E21\u0E48\u0E1E\u0E49\u0E19\u0E2B\u0E23\u0E2D\u0E01\u0E19\u0E30\u0E25\u0E39\u0E01"
    - "\u0E1B\u0E49\u0E32\u0E28\u0E23\u0E35: \u0E23\u0E30\u0E27\u0E31\u0E07\u0E15\u0E31\u0E27\u0E14\u0E49\u0E27\u0E22\u0E19\u0E30\u0E25\u0E39\u0E01"
    peakReveal:
    - "\u0E2B\u0E21\u0E2D\u0E14\u0E39: \u0E2B\u0E38\u0E48\u0E19\u0E19\u0E31\u0E48\u0E19\u0E01\u0E39\u0E17\u0E33\u0E44\u0E27\u0E49\u0E25\u0E48\u0E2D...
      \u0E08\u0E30\u0E40\u0E02\u0E35\u0E22\u0E19\u0E0A\u0E37\u0E48\u0E2D\u0E43\u0E04\u0E23\u0E01\u0E47\u0E40\u0E1C\u0E32\u0E44\u0E1B\u0E40\u0E16\u0E2D\u0E30"
    - "\u0E2B\u0E21\u0E2D\u0E14\u0E39: \u0E02\u0E2D\u0E07\u0E08\u0E23\u0E34\u0E07\u0E19\u0E48\u0E30
      \u0E2D\u0E22\u0E39\u0E48\u0E17\u0E35\u0E48\u0E02\u0E49\u0E2D\u0E21\u0E37\u0E2D\u0E21\u0E36\u0E07"
    - "\u0E2B\u0E21\u0E2D\u0E14\u0E39: \u0E17\u0E38\u0E01\u0E04\u0E23\u0E31\u0E49\u0E07\u0E17\u0E35\u0E48\u0E21\u0E36\u0E07\u0E2B\u0E19\u0E35\u0E04\u0E27\u0E32\u0E21\u0E15\u0E32\u0E22
      \u0E14\u0E27\u0E07\u0E21\u0E36\u0E07\u0E44\u0E2B\u0E25\u0E21\u0E32\u0E2B\u0E32\u0E01\u0E39...
      \u0E41\u0E25\u0E49\u0E27\u0E04\u0E19\u0E2D\u0E37\u0E48\u0E19\u0E01\u0E47\u0E15\u0E32\u0E22\u0E41\u0E17\u0E19\u0E21\u0E36\u0E07"
    - "\u0E2B\u0E21\u0E2D\u0E14\u0E39: \u0E21\u0E36\u0E07\u0E04\u0E34\u0E14\u0E27\u0E48\u0E32\u0E21\u0E36\u0E07\u0E0A\u0E48\u0E27\u0E22\u0E43\u0E04\u0E23\u0E44\u0E14\u0E49\u0E40\u0E2B\u0E23\u0E2D?"
    peakLineSeconds: 3.4
    childDeath: "\u0E27\u0E34\u0E48\u0E07\u0E15\u0E32\u0E21\u0E25\u0E39\u0E01\u0E1A\u0E2D\u0E25\u0E2D\u0E2D\u0E01\u0E1B\u0E32\u0E01\u0E0B\u0E2D\u0E22
      \u0E42\u0E14\u0E19\u0E23\u0E16\u0E01\u0E23\u0E30\u0E1A\u0E30\u0E0A\u0E19"
    auntDeath: "\u0E15\u0E01\u0E08\u0E32\u0E01\u0E14\u0E32\u0E14\u0E1F\u0E49\u0E32\u0E1A\u0E49\u0E32\u0E19\u0E15\u0E31\u0E27\u0E40\u0E2D\u0E07"
    uncleDeath: "\u0E1B\u0E35\u0E19\u0E1A\u0E31\u0E19\u0E44\u0E14\u0E43\u0E2B\u0E21\u0E48\u0E02\u0E36\u0E49\u0E19\u0E44\u0E1B\u0E15\u0E48\u0E2D\u0E2A\u0E32\u0E22
      \u0E42\u0E14\u0E19\u0E44\u0E1F\u0E41\u0E23\u0E07\u0E2A\u0E39\u0E07\u0E14\u0E39\u0E14"
    peakTitle: "\u0E0A\u0E48\u0E27\u0E22\u0E43\u0E04\u0E23\u0E44\u0E21\u0E48\u0E44\u0E14\u0E49\u0E40\u0E25\u0E22...\n<size=30>\u0E17\u0E38\u0E01\u0E04\u0E23\u0E31\u0E49\u0E07\u0E17\u0E35\u0E48\u0E20\u0E1E\u0E2B\u0E19\u0E35\u0E04\u0E27\u0E32\u0E21\u0E15\u0E32\u0E22
      \u0E04\u0E19\u0E2D\u0E37\u0E48\u0E19\u0E15\u0E49\u0E2D\u0E07\u0E08\u0E48\u0E32\u0E22\u0E41\u0E17\u0E19</size>"
    endingTitle: "\u0E20\u0E1E\u0E22\u0E2D\u0E21\u0E23\u0E31\u0E1A\u0E14\u0E27\u0E07\u0E02\u0E2D\u0E07\u0E15\u0E31\u0E27\u0E40\u0E2D\u0E07\n<size=30>\u0E04\u0E19\u0E43\u0E19\u0E0B\u0E2D\u0E22\u0E23\u0E2D\u0E14\u0E17\u0E38\u0E01\u0E04\u0E19
      \u2014 \u0E14\u0E27\u0E07\u0E17\u0E35\u0E48\u0E16\u0E39\u0E01\u0E02\u0E42\u0E21\u0E22\u0E44\u0E1B\u0E01\u0E25\u0E31\u0E1A\u0E04\u0E37\u0E19\u0E40\u0E08\u0E49\u0E32\u0E02\u0E2D\u0E07</size>\n\n\u0E14\u0E27\u0E07\u0E16\u0E36\u0E07\u0E06\u0E32\u0E15"
